+struct LoginFieldFallbacks {
+  std::optional<FieldGlobalId> username;
+  std::optional<FieldGlobalId> password;
+};
+
+bool IsVisibleAutocompletableField(const FormFieldData& field) {
+  return field.is_focusable() && field.is_visible() &&
+         field.should_autocomplete();
+}
+
+LoginFieldFallbacks FindLoginFieldFallbacks(const FormData& form) {
+  std::optional<size_t> password_index;
+  for (size_t i = 0; i < form.fields().size(); ++i) {
+    const FormFieldData& field = form.fields()[i];
+    if (field.form_control_type() != FormControlType::kInputPassword ||
+        !IsVisibleAutocompletableField(field)) {
+      continue;
+    }
+    // Multiple password inputs usually indicate account creation or password
+    // change. Leave those forms to explicit attributes and normal predictions.
+    if (password_index) {
+      return {};
+    }
+    password_index = i;
+  }
+  if (!password_index) {
+    return {};
+  }
+
+  LoginFieldFallbacks fallbacks;
+  fallbacks.password = form.fields()[*password_index].global_id();
+
+  std::optional<FieldGlobalId> username_candidate;
+  bool multiple_username_candidates = false;
+  for (size_t i = 0; i < *password_index; ++i) {
+    const FormFieldData& field = form.fields()[i];
+    if (!IsVisibleAutocompletableField(field)) {
+      continue;
+    }
+    if (field.form_control_type() == FormControlType::kInputEmail ||
+        field.form_control_type() == FormControlType::kInputText) {
+      multiple_username_candidates |= username_candidate.has_value();
+      username_candidate = field.global_id();
+    }
+  }
+
+  // Only relabel an unambiguous account identifier. This avoids treating
+  // profile or account-creation fields as login usernames.
+  if (username_candidate && !multiple_username_candidates) {
+    fallbacks.username = username_candidate;
+  }
+  return fallbacks;
+}
+
+FieldType GetLoginFieldFallback(const AutofillField& field,
+                                const LoginFieldFallbacks& fallbacks) {
+  const HtmlFieldType html_type = field.html_type();
+  if ((html_type != HtmlFieldType::kUnspecified &&
+       html_type != HtmlFieldType::kUnrecognized) ||
+      (field.server_type() != NO_SERVER_DATA &&
+       field.server_type() != UNKNOWN_TYPE)) {
+    return UNKNOWN_TYPE;
+  }
+
+  const FieldType current_type = GetMostRelevantFieldType(field.Type());
+  if (fallbacks.username == field.global_id() &&
+      (current_type == UNKNOWN_TYPE || current_type == EMAIL_ADDRESS)) {
+    return USERNAME;
+  }
+  if (fallbacks.password == field.global_id() && current_type == UNKNOWN_TYPE) {
+    return PASSWORD;
+  }
+  return UNKNOWN_TYPE;
+}
+
