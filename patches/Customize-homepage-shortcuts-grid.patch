+    private static @DrawableRes int getBundledSiteIcon(GURL url) {
+        String host = url.getHost();
+        if (isDomain(host, "google.com")
+                || isDomain(host, "google.cn")
+                || host.matches("(www\\.)?google\\.[a-z]{2,3}(\\.[a-z]{2})?")) {
+            return R.drawable.ntp_shortcut_google;
+        }
+        if (isDomain(host, "reddit.com") || isDomain(host, "redd.it")) {
+            return R.drawable.ntp_shortcut_reddit;
+        }
+        if (isDomain(host, "x.com") || isDomain(host, "twitter.com")) {
+            return R.drawable.ntp_shortcut_x;
+        }
+        if (isDomain(host, "youtube.com") || isDomain(host, "youtu.be")) {
+            return R.drawable.ntp_shortcut_youtube;
+        }
+        if (isDomain(host, "qq.com")) {
+            return R.drawable.ntp_shortcut_qq;
+        }
+        if (isDomain(host, "github.com")) {
+            return R.drawable.ntp_shortcut_github;
+        }
+        return 0;
+    }
+
+    private static boolean isDomain(String host, String domain) {
+        return host.equals(domain) || host.endsWith("." + domain);
+    }
