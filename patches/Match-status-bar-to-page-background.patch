+    private void schedulePageTopColorSampling() {
+        schedulePageTopColorSampling(/* sampleImmediately= */ false);
+    }
+
+    private void schedulePageTopColorSampling(boolean sampleImmediately) {
+        cancelPageTopColorSampling();
+        if (!areBrowserControlsAtBottom()
+                || mCurrentTab == null
+                || mCurrentTab.getNativePage() != null
+                || mIsOmniboxFocused) {
+            return;
+        }
+
+        if (sampleImmediately) {
+            mPageTopColorSamplingHandler.post(mPageTopColorSamplingRunnable);
+        } else {
+            mPageTopColorSamplingHandler.postDelayed(
+                    mPageTopColorSamplingRunnable, PAGE_TOP_COLOR_SAMPLE_DELAY_MS);
+        }
+        // Some pages repaint their header shortly after load, so sample once more after it settles.
+        mPageTopColorSamplingHandler.postDelayed(
+                mPageTopColorSamplingRunnable, PAGE_TOP_COLOR_RESAMPLE_DELAY_MS);
+    }
+
+    private void cancelPageTopColorSampling() {
+        mPageTopColorSamplingGeneration++;
+        mPageTopColorSamplingHandler.removeCallbacks(mPageTopColorSamplingRunnable);
+    }
+
+    private void requestPageTopColor(int generation) {
+        Tab sampledTab = mCurrentTab;
+        if (generation != mPageTopColorSamplingGeneration
+                || sampledTab == null
+                || !areBrowserControlsAtBottom()
+                || sampledTab.getNativePage() != null
+                || mIsOmniboxFocused) {
+            return;
+        }
+
+        View rootView = mWindow.getDecorView().getRootView();
+        if (!rootView.isAttachedToWindow()
+                || rootView.getWidth() <= 0
+                || rootView.getHeight() <= 0) {
+            return;
+        }
+
+        Rect visibleFrame = new Rect();
+        rootView.getWindowVisibleDisplayFrame(visibleFrame);
+        int[] locationOnScreen = new int[2];
+        int[] locationInWindow = new int[2];
+        rootView.getLocationOnScreen(locationOnScreen);
+        rootView.getLocationInWindow(locationInWindow);
+        int windowTopOnScreen = locationOnScreen[1] - locationInWindow[1];
+        int statusBarBottom =
+                Math.max(
+                        mDimensionCompat.getStatusBarHeight(),
+                        Math.max(0, visibleFrame.top - windowTopOnScreen));
+        if (rootView.getRootWindowInsets() != null) {
+            statusBarBottom =
+                    Math.max(
+                            statusBarBottom,
+                            WindowInsetsCompat.toWindowInsetsCompat(rootView.getRootWindowInsets())
+                                    .getInsetsIgnoringVisibility(
+                                            WindowInsetsCompat.Type.statusBars())
+                                    .top);
+        }
+        int sampleTop = Math.min(statusBarBottom + 2, rootView.getHeight() - 1);
+        int sampleBottom =
+                Math.min(sampleTop + PAGE_TOP_COLOR_SAMPLE_HEIGHT_PX, rootView.getHeight());
+        if (sampleBottom <= sampleTop) return;
+
+        CompositorViewHolder compositorViewHolder =
+                mActivity.findViewById(R.id.compositor_view_holder);
+        View activeSurfaceView =
+                compositorViewHolder == null ? null : compositorViewHolder.getActiveSurfaceView();
+        if (!(activeSurfaceView instanceof SurfaceView surfaceView)
+                || surfaceView.getWidth() <= 0
+                || surfaceView.getHeight() <= 0) {
+            return;
+        }
+
+        int[] surfaceLocationInWindow = new int[2];
+        surfaceView.getLocationInWindow(surfaceLocationInWindow);
+        int sampleTopInSurface = Math.max(0, sampleTop - surfaceLocationInWindow[1]);
+        int sampleBottomInSurface =
+                Math.min(
+                        sampleTopInSurface + PAGE_TOP_COLOR_SAMPLE_HEIGHT_PX,
+                        surfaceView.getHeight());
+        if (sampleBottomInSurface <= sampleTopInSurface) return;
+
+        Rect sourceRect =
+                new Rect(0, sampleTopInSurface, surfaceView.getWidth(), sampleBottomInSurface);
+        Bitmap bitmap =
+                Bitmap.createBitmap(
+                        sourceRect.width(), sourceRect.height(), Bitmap.Config.ARGB_8888);
+        Surface surface = surfaceView.getHolder().getSurface();
+        if (!surface.isValid()) {
+            bitmap.recycle();
+            return;
+        }
+        try {
+            PixelCopy.request(
+                    surface,
+                    sourceRect,
+                    bitmap,
+                    result -> {
+                        if (result == PixelCopy.SUCCESS
+                                && generation == mPageTopColorSamplingGeneration
+                                && sampledTab == mCurrentTab) {
+                            @ColorInt int sampledColor = calculateAverageColor(bitmap);
+                            mPageTopColors.put(sampledTab, sampledColor);
+                            if (mPageTopColor != sampledColor) {
+                                mPageTopColor = sampledColor;
+                                updateStatusBarColor();
+                            }
+                        }
+                        bitmap.recycle();
+                    },
+                    mPageTopColorSamplingHandler);
+        } catch (IllegalArgumentException exception) {
+            bitmap.recycle();
+        }
+    }
+
+    private static @ColorInt int calculateAverageColor(Bitmap bitmap) {
+        long red = 0;
+        long green = 0;
+        long blue = 0;
+        int pixelCount = bitmap.getWidth() * bitmap.getHeight();
+        for (int y = 0; y < bitmap.getHeight(); y++) {
+            for (int x = 0; x < bitmap.getWidth(); x++) {
+                @ColorInt int color = bitmap.getPixel(x, y);
+                red += Color.red(color);
+                green += Color.green(color);
+                blue += Color.blue(color);
+            }
+        }
+        return Color.rgb(
+                (int) (red / pixelCount), (int) (green / pixelCount), (int) (blue / pixelCount));
+    }
+
