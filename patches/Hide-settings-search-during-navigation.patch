+    // Replaces the header pane with a wrapper that keeps root-only UI out of the detail pane.
+    private void addHeaderSearchContainer(SlidingPaneLayout slidingPaneLayout) {
+        View oldHeaderView = slidingPaneLayout.findViewById(R.id.preferences_header);
+        int headerIndex = slidingPaneLayout.indexOfChild(oldHeaderView);
+        LayoutParams headerLayoutParams = oldHeaderView.getLayoutParams();
+        slidingPaneLayout.removeView(oldHeaderView);
+
+        LinearLayout newHeaderView = new LinearLayout(oldHeaderView.getContext());
+        newHeaderView.setId(R.id.preferences_header_pane);
+        newHeaderView.setOrientation(LinearLayout.VERTICAL);
+
+        FrameLayout searchBoxContainer = new FrameLayout(oldHeaderView.getContext());
+        searchBoxContainer.setId(R.id.settings_root_search_box_container);
+        newHeaderView.addView(
+                searchBoxContainer,
+                new LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT));
+
+        FragmentContainerView headerFragmentContainer =
+                new FragmentContainerView(oldHeaderView.getContext());
+        headerFragmentContainer.setId(R.id.preferences_header);
+        newHeaderView.addView(
+                headerFragmentContainer,
+                new LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, 0, 1f));
+
+        slidingPaneLayout.addView(newHeaderView, headerIndex, headerLayoutParams);
+    }
