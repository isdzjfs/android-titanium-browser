diff --git a/chrome/browser/ui/android/exclusive_access/exclusive_access_bubble_android.cc b/chrome/browser/ui/android/exclusive_access/exclusive_access_bubble_android.cc
--- a/chrome/browser/ui/android/exclusive_access/exclusive_access_bubble_android.cc
+++ b/chrome/browser/ui/android/exclusive_access/exclusive_access_bubble_android.cc
@@ -107,6 +107,14 @@ void ExclusiveAccessBubbleAndroid::Hide() {
 }
 
 void ExclusiveAccessBubbleAndroid::Show() {
+  // Titanium does not show the repetitive exit instructions for plain HTML
+  // fullscreen. Keep notices that carry additional security or download state.
+  const bool is_plain_html_fullscreen =
+      params_.type == EXCLUSIVE_ACCESS_BUBBLE_TYPE_FULLSCREEN_EXIT_INSTRUCTION &&
+      !params_.has_download;
+  if (is_plain_html_fullscreen) {
+    return;
+  }
   was_shown_ = true;
   bridge_->Show();
 }
@@ -161,6 +169,22 @@ void ExclusiveAccessBubbleAndroid::Update(
   if (!params.has_download) {
     params_.type = params.type;
   }
+
+  // Java's Update() creates and shows the snackbar when one does not already
+  // exist, so suppressing Show() alone is too late for plain HTML fullscreen.
+  // Keep pointer/keyboard lock and download notices because they communicate
+  // additional security-relevant state.
+  const bool is_plain_html_fullscreen =
+      params_.type == EXCLUSIVE_ACCESS_BUBBLE_TYPE_FULLSCREEN_EXIT_INSTRUCTION &&
+      !params_.has_download;
+  if (is_plain_html_fullscreen) {
+    RunHideCallbackIfNeeded(ExclusiveAccessBubbleHideReason::kNotShown);
+    if (already_shown) {
+      bridge_->Hide();
+    }
+    return;
+  }
+
   UpdateBubbleContent(params_.type);
   ShowAndStartTimers();
 }
